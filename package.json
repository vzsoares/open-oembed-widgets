{
    "name": "notion-oembed-widgets",
    "version": "1.0.0",
    "type": "module",
    "description": "Tiny, monochrome, client-side widgets you can embed in Notion via oEmbed. Deployed to GitHub Pages.",
    "scripts": {
        "dev": "vite",
        "build": "vite build && bun scripts/gen-oembed.ts",
        "preview": "vite preview",
        "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
        "test": "bun test",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "keywords": [
        "notion",
        "oembed",
        "widgets",
        "bitcoin",
        "vite",
        "alpinejs",
        "tailwindcss",
        "github-pages"
    ],
    "author": "vzsoares",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/vzsoares/notion-oembed-widgets.git"
    },
    "homepage": "https://vzsoares.github.io/notion-oembed-widgets/",
    "bugs": {
        "url": "https://github.com/vzsoares/notion-oembed-widgets/issues"
    },
    "dependencies": {
        "alpinejs": "^3.13.0"
    },
    "devDependencies": {
        "@types/alpinejs": "^3.13.11",
        "@types/bun": "^1.1.0",
        "autoprefixer": "^10.4.14",
        "postcss": "^8.4.24",
        "prettier": "^3.3.0",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.8.2",
        "vite": "^5.4.0"
    }
}
