{
    "name": "open-oembed-widgets",
    "version": "2.8.0",
    "type": "module",
    "description": "Tiny, monochrome, client-side widgets you can embed in Notion or any oEmbed consumer. Deployed to GitHub Pages.",
    "scripts": {
        "dev": "vite",
        "build": "vite build && bun scripts/gen-oembed.ts",
        "preview": "vite preview",
        "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "lint": "biome check .",
        "format": "biome check --write ."
    },
    "keywords": [
        "notion",
        "oembed",
        "widgets",
        "bitcoin",
        "vite",
        "alpinejs",
        "tailwindcss",
        "github-pages"
    ],
    "author": "vzsoares",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/vzsoares/open-oembed-widgets.git"
    },
    "homepage": "https://vzsoares.github.io/open-oembed-widgets/",
    "bugs": {
        "url": "https://github.com/vzsoares/open-oembed-widgets/issues"
    },
    "dependencies": {
        "alpinejs": "^3.13.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.0.0",
        "@playwright/test": "^1.60.0",
        "@tailwindcss/vite": "^4.0.0",
        "@types/alpinejs": "^3.13.11",
        "@types/bun": "^1.1.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.0",
        "vitest": "^4.1.7"
    }
}
